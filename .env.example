# Northstar Finance OS — environment variable template.
# Copy to .env and fill in local values. Never commit .env or real secrets.

# Database (PostgreSQL preferred; SQLite acceptable for a first iteration)
DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar_finance_os

# API
API_SECRET_KEY=replace-with-a-local-placeholder-value
API_HOST=0.0.0.0
API_PORT=8000

# AI provider (placeholder only — never a real key)
LLM_API_KEY=replace-with-a-local-placeholder-value
LLM_MODEL=replace-with-model-id

# Feature flags
AI_CONFIDENCE_THRESHOLD=0.95
